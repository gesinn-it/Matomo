{
	"name": "Matomo",
	"version": "1.0.0",
	"author": [
		"Alexander Gesinn (gesinn.it GmbH & Co. KG)"
	],
	"url": "https://github.com/gesinn-it/Matomo",
	"descriptionmsg": "matomo-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\Matomo\\": "./src/"
	},
	"MessagesDirs": {
		"Matomo": [
			"i18n"
		]
	},
	"HookHandlers": {
		"Matomo": {
			"class": "MediaWiki\\Extension\\Matomo\\Hooks"
		}
	},
	"Hooks": {
		"BeforePageDisplay": "Matomo",
		"SkinAfterBottomScripts": "Matomo",
		"SpecialSearchResults": "Matomo",
		"SpecialSearchSetupEngine": "Matomo"
	},
	"ResourceModules": {
		"ext.matomo.tracker": {
			"packageFiles": [
				"tracker.js",
				"track.js",
				{
					"name": "config.json",
					"callback": "MediaWiki\\Extension\\Matomo\\Hooks::getTrackerConfig"
				}
			],
			"localBasePath": "resources/ext.matomo.tracker",
			"remoteExtPath": "Matomo/resources/ext.matomo.tracker"
		}
	},
	"config": {
		"MatomoURL": {
			"value": ""
		},
		"MatomoIDSite": {
			"value": ""
		},
		"MatomoProtocol": {
			"value": "auto"
		},
		"MatomoIgnoreGroups": {
			"value": [ "bot", "sysop" ]
		},
		"MatomoCustomJS": {
			"value": []
		}
	},
	"load_composer_autoloader": true,
	"manifest_version": 2
}
