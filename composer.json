{
	"name": "gesinn-it/matomo",
	"type": "mediawiki-extension",
	"description": "MediaWiki extension for privacy-friendly Matomo pageview tracking",
	"keywords": [
		"Extension",
		"Wiki",
		"MediaWiki",
		"Matomo",
		"Analytics"
	],
	"homepage": "https://github.com/gesinn-it/Matomo",
	"license": "GPL-2.0-or-later",
	"extra": {
		"installer-name": "Matomo"
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "47.0.0",
		"mediawiki/mediawiki-phan-config": "0.16.0",
		"mediawiki/minus-x": "1.1.3",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs"
		],
		"fix": [
			"@phpcs-fix"
		],
		"lint": "parallel-lint . --exclude vendor --exclude node_modules",
		"phpcs": "phpcs -ps",
		"phpcs-fix": "phpcbf -p",
		"phpunit": [
			"Composer\\Config::disableProcessTimeout",
			"bash -c 'extDir=$(pwd) && cd ${MW_INSTALL_PATH:-../..} && { [ -f tests/phpunit/generatePHPUnitConfig.php ] && { php tests/phpunit/generatePHPUnitConfig.php >/dev/null 2>&1 || true; [ -f phpunit.xml ] || printf \"%s\" \"<phpunit><!-- generatePHPUnitConfig --></phpunit>\" > phpunit.xml; } || true; } && MEDIAWIKI_HAS_INTEGRATION_TESTS=1 vendor/bin/phpunit -c \"$extDir/phpunit.xml.dist\" --bootstrap tests/phpunit/bootstrap.php --testdox'"
		],
		"phpunit-coverage": "@phpunit --coverage-text --coverage-html extensions/Matomo/coverage/php --coverage-clover extensions/Matomo/coverage/php/coverage.xml",
		"minus-x": "minus-x check .",
		"phan": "phan --allow-polyfill-parser"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	}
}
