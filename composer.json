{
	"name": "gesinn-it/matomo",
	"type": "mediawiki-extension",
	"description": "MediaWiki extension for privacy-friendly Matomo pageview tracking",
	"keywords": [
		"Extension",
		"Wiki",
		"MediaWiki",
		"Matomo",
		"Analytics"
	],
	"homepage": "https://github.com/gesinn-it/Matomo",
	"license": "GPL-2.0-or-later",
	"extra": {
		"installer-name": "Matomo"
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "50.0.0",
		"mediawiki/mediawiki-phan-config": "0.20.0",
		"mediawiki/minus-x": "2.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0"
	},
	"scripts": {
		"test": [
			"@analyze",
			"@phpunit"
		],
		"test-coverage": [
			"@analyze",
			"@phpunit-coverage"
		],
		"analyze": [
			"@lint",
			"@phpcs"
		],
		"fix": [
			"@phpcs-fix"
		],
		"lint": "parallel-lint . --exclude vendor --exclude node_modules",
		"phpcs": "phpcs -ps",
		"phpcs-fix": "phpcbf -p",
		"phpunit": "php ../../tests/phpunit/phpunit.php -c phpunit.xml.dist --testdox",
		"phpunit-coverage": "php ../../tests/phpunit/phpunit.php -c phpunit.xml.dist --testdox --coverage-text --coverage-html coverage/php --coverage-clover coverage/php/coverage.xml",
		"minus-x": "minus-x check .",
		"phan": "phan --allow-polyfill-parser"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true
		}
	}
}
